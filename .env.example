# 线上地址参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
#
# ZCODE_BASE_URL 决定客户端（桌面安装包）连到哪台服务器，它在**构建时**被烘进产物：
# main / preload / renderer 三处都会写入 __ZCODE_ENDPOINT_ENV__。运行期改不了指向
# （production 构建下 SetZCodeEndpointOverride 是 no-op，packaged 应用也会忽略
# ZCODE_UPDATE_FEED_URL），所以发版前必须确认它指向你自己的平台服务，
# 否则客户端登录、模型目录与更新检查仍会打到厂商域名。
ZCODE_BASE_URL=https://zcode.z.ai
BIGMODEL_API_BASE_URL=https://bigmodel.cn
ZAI_OAUTH_ORIGIN=https://chat.z.ai
ZAI_BUSINESS_BASE_URL=https://api.z.ai
# 线上公开 OAuth client id，不是 secret。
ZAI_OAUTH_CLIENT_ID=client_P8X5CMWmlaRO9gyO-KSqtg
ZCODE_CDN_BASE_URL=https://cdn-zcode.z.ai

# 导入会话的来源回链 base，不改变 API；保留 /cn/share，不含分享码。
# 修改 API origin 时同步修改此值，或删除此项以自动跟随 API origin；不要赋空值。
ZCODE_CONVERSATION_SHARE_WEB_URL=https://zcode.z.ai/cn/share
# 远程资源完整覆盖地址，必须包含与运行版本匹配的版本号；删除此项可自动按版本推导。
ZCODE_REMOTE_ASSET_CDN_BASE_URL=https://cdn-zcode.z.ai/zcode/electron/releases/3.14.0

# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=

# 平台服务端进程环境变量（@zcode/platform）。
# 只在服务端设置，不要打进客户端产物：其中令牌签名密钥一旦泄露即可伪造任意用户会话。
#
# 令牌签名密钥，必填。缺失时平台拒绝启动（不允许默认值兜底）。
ZCODE_PLATFORM_TOKEN_SECRET=
# 对外站点地址（如 https://zcode.example.com）。用来生成客户端拉取的模型目录与更新产物地址，
# 反向代理后面必须显式配置，否则只能从请求头推断，而请求头是客户端可伪造的。
ZCODE_PLATFORM_PUBLIC_ORIGIN=
# 数据库路径与数据目录；默认 <数据目录>/platform.sqlite。
ZCODE_PLATFORM_DB_PATH=
ZCODE_PLATFORM_DATA_DIR=
# 监听地址与端口；默认 127.0.0.1:3100。容器内需设为 0.0.0.0 才能被反代访问。
# 平台持有上游 API key 与全部用户余额，对外开放必须是显式决定。
ZCODE_PLATFORM_HOST=
ZCODE_PLATFORM_PORT=
# 会话有效期（毫秒），默认 30 天。
ZCODE_PLATFORM_SESSION_TTL_MS=
# 单次模型请求的输出上限；0 表示不限制。用于限制单次预扣敞口。
ZCODE_PLATFORM_OUTPUT_TOKEN_CAP=
# 上游转发超时（毫秒），默认 10 分钟。含流式响应的总时长。
ZCODE_PLATFORM_UPSTREAM_TIMEOUT_MS=
# 管理后台静态目录与客户端产物目录；容器部署时由镜像固定为 /app/console 与 /data/releases。
ZCODE_PLATFORM_CONSOLE_DIR=
ZCODE_PLATFORM_RELEASES_DIR=
# debug | info | warn | error，默认 info。
ZCODE_PLATFORM_LOG_LEVEL=
